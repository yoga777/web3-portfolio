# WalletConnect / Reown Cloud project id (free: https://cloud.reown.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_reown_project_id_here
# Optional: Alchemy API key for a more reliable RPC (free tier). If empty, public RPC is used.
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_key_here
# PortfolioRegistry contract address. Leave as zero address until the contract is deployed —
# the UI detects the zero address and disables on-chain actions honestly.
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# 84532 = Base Sepolia (testnet). Use 8453 for Base Mainnet in production.
NEXT_PUBLIC_CHAIN_ID=84532
# Optional: IPFS CID of the current build / CV file, shown in footer & hero only when set.
NEXT_PUBLIC_BUILD_IPFS_CID=
NEXT_PUBLIC_CV_IPFS_CID=
